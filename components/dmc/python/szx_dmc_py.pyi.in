"""Static type declarations generated by the DMC CMake build."""

from enum import Enum
from typing import Callable, Optional


class DmcError(Enum):
    Success: DmcError
    InvalidArgument: DmcError
    DriverUnavailable: DmcError
    ArchitectureMismatch: DmcError
    SymbolUnavailable: DmcError
    BoardNotFound: DmcError
    NotConnected: DmcError
    Busy: DmcError
    SafetyLatched: DmcError
    AxisNotReady: DmcError
    NotHomed: DmcError
    LimitReached: DmcError
    MotionTimeout: DmcError
    IoUnavailable: DmcError
    CompareUnavailable: DmcError
    CompareQueueFull: DmcError
    TriggerTimeout: DmcError
    FrameProgressInvalid: DmcError
    Cancelled: DmcError
    ResourceExhausted: DmcError
    UnexpectedFailure: DmcError
    BufferTooSmall: DmcError


class DmcState(Enum):
    Disconnected: DmcState
    Ready: DmcState
    Armed: DmcState
    WaitingForStart: DmcState
    Preparing: DmcState
    Scanning: DmcState
    WaitingForFrames: DmcState
    Completed: DmcState
    Cancelled: DmcState
    Failed: DmcState
    SafetyLatched: DmcState


class StartSource(Enum):
    None: StartSource
    SoftwareCommand: StartSource
    HardwareTrigger: StartSource
    Any: StartSource


class FrameTriggerSource(Enum):
    Software: FrameTriggerSource
    PositionCompareOutput: FrameTriggerSource


class StopMode(Enum):
    Decelerated: StopMode
    Emergency: StopMode


class DmcModel(Enum):
    GenericLTDMC: DmcModel
    LeiSaiLTDMC: DmcModel
    Custom: DmcModel


class DmcLogLevel(Enum):
    Debug: DmcLogLevel
    Trace: DmcLogLevel
    Info: DmcLogLevel
    Warning: DmcLogLevel
    Error: DmcLogLevel


LogSink = Callable[[DmcLogLevel, str], None]
class InputSnapshot:
    active_bits: int
    sampled_bits: int
    timestamp_nanoseconds: int
    valid: bool


InputEventSink = Callable[[InputSnapshot], None]


class DmcConfig:
    model: DmcModel
    profile_id: str
    card_index: int
    simulation: bool
    allow_simulation_fallback: bool
    compare_queue_capacity: int
    input_count: int
    output_count: int
    software_trigger_pulse_milliseconds: int
    home_timeout_seconds: float
    home_max_travel: float
    home_origin_input: int
    home_origin_active_level: bool
    home_require_origin_seen: bool
    home_expected_initial_direction: int
    log_sink: Optional[LogSink]

    def __init__(self) -> None: ...


class DmcStatus:
    state: DmcState
    last_error: DmcError
    operation_id: int
    current_row: int
    total_rows: int
    compared_triggers: int
    received_frames: int
    expected_frames: int
    compare_queue_remaining: int
    safety_latched: bool
    compare_enabled: bool
    model: DmcModel
    profile_id: str
    diagnostic: str


class ComparePoint:
    position: float
    ordinal: int
    row: int
    column: int

    def __init__(self) -> None: ...


class ScanPlan:
    scan_axis: int
    row_axis: int
    scan_positions: list[float]
    row_positions: list[float]
    scan_start_position: float
    scan_end_position: float
    scan_speed: float
    row_speed: float

    def __init__(self) -> None: ...


class CaptureRequest:
    operation_id: int
    start_source: StartSource
    trigger_source: FrameTriggerSource
    expected_frames: int
    compare_output: int
    compare_output_active_level: bool
    compare_pulse_cycles: int
    compare_queue_capacity: int
    compare_points: list[ComparePoint]
    scan_plan: ScanPlan

    def __init__(self) -> None: ...


class DmcControllerFactory:
    @staticmethod
    def create(config: DmcConfig = ...) -> DmcController: ...


class DmcController:
    def connect(self) -> None: ...
    def disconnect(self) -> None: ...
    def status(self) -> DmcStatus: ...
    def arm_capture(self, request: CaptureRequest) -> None: ...
    def start_capture(self, operation_id: int, source: StartSource = ...) -> None: ...
    def acknowledge_compare_trigger(self, operation_id: int, count: int) -> None: ...
    def acknowledge_frame_progress(self, operation_id: int, frames: int) -> None: ...
    def complete_camera(self, operation_id: int, frames: int) -> None: ...
    def cancel_capture(self, operation_id: int, mode: StopMode = ...) -> None: ...
    def set_input_event_sink(self, sink: Optional[InputEventSink] = ...) -> None: ...
    def signal_digital_input(self, input: int, active: bool) -> None: ...
