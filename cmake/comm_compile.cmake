include_guard(GLOBAL)

# Public target-scoped compile policy shared by all components.  It deliberately
# does not use directory-wide options so vendored dependencies remain isolated.
function(szx_target_compile_settings _target)
    cmake_parse_arguments(ARG "WIN32_LEAN" "WARNING_LEVEL" "DISABLE_WARNINGS;EXTRA_DEFINES;EXTRA_OPTIONS" ${ARGN})
    if(NOT TARGET "${_target}")
        message(WARNING "szx_target_compile_settings: target '${_target}' does not exist")
        return()
    endif()
    if(NOT ARG_WARNING_LEVEL)
        set(ARG_WARNING_LEVEL HIGH)
    endif()
    if(WIN32 AND ARG_WIN32_LEAN)
        target_compile_definitions(${_target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    endif()
    if(MSVC)
        target_compile_options(${_target} PRIVATE /utf-8)
        if(ARG_WARNING_LEVEL STREQUAL HIGH)
            target_compile_options(${_target} PRIVATE /W4 /permissive-)
        elseif(ARG_WARNING_LEVEL STREQUAL NORMAL)
            target_compile_options(${_target} PRIVATE /W3)
        endif()
        foreach(_warning IN LISTS ARG_DISABLE_WARNINGS)
            string(REGEX REPLACE "^C" "" _warning_number "${_warning}")
            target_compile_options(${_target} PRIVATE "/wd${_warning_number}")
        endforeach()
    else()
        if(ARG_WARNING_LEVEL STREQUAL HIGH)
            target_compile_options(${_target} PRIVATE -Wall -Wextra -Wpedantic)
        elseif(ARG_WARNING_LEVEL STREQUAL NORMAL)
            target_compile_options(${_target} PRIVATE -Wall -Wextra)
        endif()
        foreach(_warning IN LISTS ARG_DISABLE_WARNINGS)
            target_compile_options(${_target} PRIVATE "-Wno-${_warning}")
        endforeach()
    endif()
    if(ARG_EXTRA_DEFINES)
        target_compile_definitions(${_target} PRIVATE ${ARG_EXTRA_DEFINES})
    endif()
    if(ARG_EXTRA_OPTIONS)
        target_compile_options(${_target} PRIVATE ${ARG_EXTRA_OPTIONS})
    endif()
endfunction()

function(szx_apply_default_compile_policy _target)
    szx_target_compile_settings(${_target} WIN32_LEAN
        DISABLE_WARNINGS C4100 C4127 C4189 C4701 C4702 C4714 C4458)
endfunction()

