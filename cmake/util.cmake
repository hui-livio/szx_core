include_guard(GLOBAL)

function(szx_find_qt)
    cmake_parse_arguments(ARG "QUIET" "MINIMUM_VERSION" "COMPONENTS" ${ARGN})
    if(NOT ARG_MINIMUM_VERSION)
        set(ARG_MINIMUM_VERSION 6.5)
    endif()
    if(NOT ARG_COMPONENTS)
        set(ARG_COMPONENTS Core Network Quick QuickControls2)
    endif()
    find_package(Qt6 ${ARG_MINIMUM_VERSION} CONFIG ${ARG_QUIET} COMPONENTS ${ARG_COMPONENTS})
    set(SZX_QT_FOUND ${Qt6_FOUND} PARENT_SCOPE)
    set(SZX_QT_VERSION "${Qt6_VERSION}" PARENT_SCOPE)
endfunction()

function(szx_windeployqt _target)
    if(NOT WIN32 OR NOT TARGET "${_target}")
        return()
    endif()
    find_program(_windeployqt windeployqt HINTS "${Qt6_DIR}/../../../bin")
    if(NOT _windeployqt)
        message(WARNING "szx_windeployqt: windeployqt not found")
        return()
    endif()
    cmake_parse_arguments(ARG "NO_TRANSLATIONS;NO_COMPILER_RUNTIME;NO_OPENGL_SW" "QML_DIR;WORKING_DIR" "EXTRA_ARGS" ${ARGN})
    set(_args --verbose 0)
    if(ARG_QML_DIR)
        list(APPEND _args --qmldir "${ARG_QML_DIR}")
    endif()
    if(ARG_NO_TRANSLATIONS)
        list(APPEND _args --no-translations)
    endif()
    if(ARG_NO_COMPILER_RUNTIME)
        list(APPEND _args --no-compiler-runtime)
    endif()
    if(ARG_NO_OPENGL_SW)
        list(APPEND _args --no-opengl-sw)
    endif()
    list(APPEND _args ${ARG_EXTRA_ARGS})
    add_custom_command(TARGET ${_target} POST_BUILD COMMAND "${_windeployqt}" ${_args} "$<TARGET_FILE:${_target}>")
endfunction()
