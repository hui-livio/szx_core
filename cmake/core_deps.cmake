include_guard(GLOBAL)
include(FetchContent)

set(SZX_THIRDPARTY_DIR "${CMAKE_CURRENT_LIST_DIR}/../third_party" CACHE PATH "Bundled third-party root")
set(SZX_OPENCV_DIR "" CACHE PATH "OpenCV package directory")
set(SZX_LIBMODBUS_ROOT "${SZX_THIRDPARTY_DIR}/libmodbus" CACHE PATH "libmodbus root")

macro(szx_fetch_local _name)
    cmake_parse_arguments(ARG "SYSTEM;EXCLUDE_FROM_ALL" "SOURCE_DIR;SOURCE_SUBDIR" "CACHE_VARS" ${ARGN})
    if(NOT IS_DIRECTORY "${ARG_SOURCE_DIR}")
        message(FATAL_ERROR "szx_fetch_local(${_name}): source directory not found: ${ARG_SOURCE_DIR}")
    endif()
    foreach(_cache IN LISTS ARG_CACHE_VARS)
        message(VERBOSE "${_name}: cache option ${_cache}")
    endforeach()
    FetchContent_Declare(${_name} SOURCE_DIR "${ARG_SOURCE_DIR}" ${ARG_SYSTEM})
    FetchContent_MakeAvailable(${_name})
endmacro()

function(szx_find_opencv)
    cmake_parse_arguments(ARG "QUIET" "ROOT" "COMPONENTS" ${ARGN})
    if(ARG_ROOT)
        set(OpenCV_DIR "${ARG_ROOT}")
    elseif(SZX_OPENCV_DIR)
        set(OpenCV_DIR "${SZX_OPENCV_DIR}")
    endif()
    if(NOT ARG_COMPONENTS)
        set(ARG_COMPONENTS core imgcodecs imgproc)
    endif()
    if(ARG_QUIET)
        find_package(OpenCV CONFIG QUIET COMPONENTS ${ARG_COMPONENTS})
    else()
        find_package(OpenCV CONFIG REQUIRED COMPONENTS ${ARG_COMPONENTS})
    endif()
    set(SZX_OPENCV_FOUND ${OpenCV_FOUND} PARENT_SCOPE)
    if(OpenCV_FOUND)
        set(SZX_OPENCV_VERSION "${OpenCV_VERSION}" PARENT_SCOPE)
        set(OpenCV_FOUND TRUE PARENT_SCOPE)
        set(OpenCV_VERSION "${OpenCV_VERSION}" PARENT_SCOPE)
        set(OpenCV_LIBS "${OpenCV_LIBS}" PARENT_SCOPE)
        set(OpenCV_INCLUDE_DIRS "${OpenCV_INCLUDE_DIRS}" PARENT_SCOPE)
    endif()
endfunction()

function(szx_find_huaray)
    set(SZX_HUARAY_ROOT "" CACHE PATH "Huaray MV Viewer Development root")
    set(SZX_HUARAY_APP_ROOT "" CACHE PATH "Huaray MV Viewer Application root")
    set(_found FALSE)
    if(WIN32 AND EXISTS "${SZX_HUARAY_ROOT}")
        set(_include_fg "${SZX_HUARAY_ROOT}/Include/IMVFG")
        set(_include_imv "${SZX_HUARAY_ROOT}/Include/IMV")
        if(CMAKE_SIZEOF_VOID_P EQUAL 8)
            set(_lib_dir "${SZX_HUARAY_ROOT}/Lib/x64")
            set(_bin_dir "${SZX_HUARAY_APP_ROOT}/x64")
        else()
            set(_lib_dir "${SZX_HUARAY_ROOT}/Lib/win32")
            set(_bin_dir "${SZX_HUARAY_APP_ROOT}/win32")
        endif()
        if(EXISTS "${_include_fg}/IMVFGApi.h" AND EXISTS "${_include_imv}/IMVApi.h"
            AND EXISTS "${_lib_dir}/MVSDKmd.lib")
            add_library(Huaray::IMVFG SHARED IMPORTED GLOBAL)
            set_target_properties(Huaray::IMVFG PROPERTIES
                INTERFACE_INCLUDE_DIRECTORIES "${_include_fg};${_include_imv}"
                IMPORTED_IMPLIB "${_lib_dir}/MVSDKmd.lib")
            if(EXISTS "${_bin_dir}/MVSDKmd.dll")
                set_target_properties(Huaray::IMVFG PROPERTIES IMPORTED_LOCATION "${_bin_dir}/MVSDKmd.dll")
            endif()
            set(_found TRUE)
        endif()
    endif()
    set(SZX_HAS_HUARAY "${_found}" PARENT_SCOPE)
    if(_found)
        message(STATUS "Huaray SDK detected: ${SZX_HUARAY_ROOT}")
    else()
        message(STATUS "Huaray SDK not detected; Huaray adapters disabled")
    endif()
endfunction()

function(szx_opencv_copy_dlls _target)
    if(NOT TARGET "${_target}" OR NOT WIN32)
        return()
    endif()
    if(COMMAND szx_copy_runtime_dlls)
        szx_copy_runtime_dlls("${_target}")
    endif()
endfunction()

function(szx_ikap_copy_dlls _target)
    if(NOT TARGET "${_target}" OR NOT WIN32)
        return()
    endif()
    if(NOT SZX_IKAP_ROOT)
        return()
    endif()
    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_bin_dir "${SZX_IKAP_ROOT}/Dll/C/x64")
    else()
        set(_bin_dir "${SZX_IKAP_ROOT}/Dll/C/x86")
    endif()
    foreach(_dll IN ITEMS IKapC.dll IKapBoard.dll)
        if(EXISTS "${_bin_dir}/${_dll}")
            add_custom_command(TARGET "${_target}" POST_BUILD
                COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "${_bin_dir}/${_dll}" "$<TARGET_FILE_DIR:${_target}>"
                COMMENT "Copying ${_dll} for ${_target}")
        endif()
    endforeach()
endfunction()

function(szx_huaray_copy_dlls _target)
    if(NOT TARGET "${_target}" OR NOT WIN32)
        return()
    endif()
    if(NOT SZX_HUARAY_APP_ROOT)
        return()
    endif()

    if(CMAKE_SIZEOF_VOID_P EQUAL 8)
        set(_bin_dir "${SZX_HUARAY_APP_ROOT}/x64")
    else()
        set(_bin_dir "${SZX_HUARAY_APP_ROOT}/win32")
    endif()

    foreach(_dll IN ITEMS MVSDKmd.dll)
        if(EXISTS "${_bin_dir}/${_dll}")
            add_custom_command(TARGET "${_target}" POST_BUILD
                COMMAND "${CMAKE_COMMAND}" -E copy_if_different
                    "${_bin_dir}/${_dll}" "$<TARGET_FILE_DIR:${_target}>"
                COMMENT "Copying ${_dll} for ${_target}")
        endif()
    endforeach()
endfunction()
