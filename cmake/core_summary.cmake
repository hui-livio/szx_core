include_guard(GLOBAL)

function(szx_print_config_summary)
    message(STATUS "")
    message(STATUS "========== SZXComponents summary ==========")
    message(STATUS "Version:       ${PROJECT_VERSION}")
    message(STATUS "Generator:     ${CMAKE_GENERATOR}")
    message(STATUS "C++ compiler:  ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
    message(STATUS "C++ standard:  ${CMAKE_CXX_STANDARD}")
    message(STATUS "Tests:         ${SZX_COMPONENTS_BUILD_TESTS}")
    message(STATUS "Network HTTP:  ${SZX_COMPONENTS_BUILD_NETWORK}")
    message(STATUS "RBAC admin:    ${SZX_COMPONENTS_BUILD_RBAC}")
    message(STATUS "Install:       ${SZX_COMPONENTS_INSTALL}")
    message(STATUS "Camera:        ${SZX_COMPONENTS_BUILD_CAMERA}")
    message(STATUS "PLC:           ${SZX_COMPONENTS_BUILD_PLC}")
    message(STATUS "DMC:           ${SZX_COMPONENTS_BUILD_DMC}")
    message(STATUS "DMC SDK:       ${SZX_DMC_HAS_LTDMC}")
    message(STATUS "Feature mgr:   ${SZX_COMPONENTS_BUILD_FEATURE_MANAGER}")
    message(STATUS "Feature Qt:    ${SZX_COMPONENTS_BUILD_FEATURE_MANAGER_QT}")
    message(STATUS "UI toolkits:   ${SZX_COMPONENTS_BUILD_UI_TOOLKITS}")
    message(STATUS "UI toolkit app:${SZX_COMPONENTS_BUILD_UI_TOOLKITS_APP}")
    message(STATUS "===========================================")
endfunction()
