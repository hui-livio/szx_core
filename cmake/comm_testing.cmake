include_guard(GLOBAL)
include(CTest)

option(SZX_FETCH_GTEST "Allow FetchContent to download GoogleTest" ON)
option(SZX_GTEST_BUILD_SHARED "Build GoogleTest as shared libraries" OFF)
set(SZX_GTEST_LOCAL_SOURCE_DIR "${CMAKE_SOURCE_DIR}/third_party/googletest" CACHE PATH "Local GoogleTest source directory")
set(SZX_GTEST_REPOSITORY "https://github.com/google/googletest.git" CACHE STRING "GoogleTest repository")
set(SZX_GTEST_TAG "v1.15.2" CACHE STRING "GoogleTest tag")
set(SZX_CTEST_REGISTRATION "binary" CACHE STRING "CTest registration: binary or case")
set(SZX_TEST_OUTPUT_DIR "${CMAKE_BINARY_DIR}/test" CACHE PATH "Test executable and runtime output directory")
set_property(CACHE SZX_CTEST_REGISTRATION PROPERTY STRINGS binary case)
string(TOLOWER "${SZX_CTEST_REGISTRATION}" SZX_CTEST_REGISTRATION)
if(NOT SZX_CTEST_REGISTRATION MATCHES "^(binary|case)$")
    message(FATAL_ERROR "SZX_CTEST_REGISTRATION must be binary or case")
endif()

function(szx_find_gtest)
    get_property(_already GLOBAL PROPERTY SZX_GTEST_FOUND SET)
    if(_already)
        get_property(_found GLOBAL PROPERTY SZX_GTEST_FOUND)
        set(SZX_GTEST_FOUND ${_found} PARENT_SCOPE)
        return()
    endif()
    set(_found FALSE)
    set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
    set(INSTALL_GTEST OFF CACHE BOOL "" FORCE)
    if(SZX_GTEST_BUILD_SHARED)
        set(BUILD_SHARED_LIBS ON)
    endif()
    if(EXISTS "${SZX_GTEST_LOCAL_SOURCE_DIR}/CMakeLists.txt")
        message(STATUS "GoogleTest: local source (${SZX_GTEST_LOCAL_SOURCE_DIR})")
        add_subdirectory("${SZX_GTEST_LOCAL_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/third_party/googletest" EXCLUDE_FROM_ALL)
    else()
        find_package(GTest CONFIG QUIET)
        if(NOT GTest_FOUND AND SZX_FETCH_GTEST)
            include(FetchContent)
            message(STATUS "GoogleTest: FetchContent (${SZX_GTEST_TAG})")
            FetchContent_Declare(googletest GIT_REPOSITORY "${SZX_GTEST_REPOSITORY}" GIT_TAG "${SZX_GTEST_TAG}" GIT_SHALLOW TRUE)
            FetchContent_MakeAvailable(googletest)
        endif()
    endif()
    if(TARGET gtest AND NOT TARGET GTest::gtest)
        add_library(GTest::gtest ALIAS gtest)
    endif()
    if(TARGET gtest_main AND NOT TARGET GTest::gtest_main)
        add_library(GTest::gtest_main ALIAS gtest_main)
    endif()
    if(TARGET gmock AND NOT TARGET GTest::gmock)
        add_library(GTest::gmock ALIAS gmock)
    endif()
    if(TARGET GTest::gtest)
        set(_found TRUE)
    endif()
    set_property(GLOBAL PROPERTY SZX_GTEST_FOUND ${_found})
    set(SZX_GTEST_FOUND ${_found} PARENT_SCOPE)
    if(NOT _found)
        message(STATUS "GoogleTest unavailable; GTest tests will be skipped")
    endif()
endfunction()

function(szx_add_test)
    cmake_parse_arguments(ARG "NO_DISCOVER;COPY_RUNTIME" "NAME;SHARDS;WORKING_DIRECTORY" "SOURCES;LIBS;DEFINES;LABELS;INCLUDES" ${ARGN})
    if(NOT ARG_NAME OR NOT ARG_SOURCES)
        message(FATAL_ERROR "szx_add_test requires NAME and SOURCES")
    endif()
    get_property(_gtest_found GLOBAL PROPERTY SZX_GTEST_FOUND)
    if(NOT _gtest_found)
        message(STATUS "Skipping GTest target '${ARG_NAME}' (GoogleTest unavailable)")
        return()
    endif()
    add_executable(${ARG_NAME} ${ARG_SOURCES})
    set_target_properties(${ARG_NAME} PROPERTIES
        RUNTIME_OUTPUT_DIRECTORY "${SZX_TEST_OUTPUT_DIR}"
        PDB_OUTPUT_DIRECTORY "${SZX_TEST_OUTPUT_DIR}")
    foreach(_config IN ITEMS Debug Release RelWithDebInfo MinSizeRel)
        string(TOUPPER "${_config}" _config_upper)
        set_target_properties(${ARG_NAME} PROPERTIES
            RUNTIME_OUTPUT_DIRECTORY_${_config_upper} "${SZX_TEST_OUTPUT_DIR}/${_config}"
            PDB_OUTPUT_DIRECTORY_${_config_upper} "${SZX_TEST_OUTPUT_DIR}/${_config}")
    endforeach()
    if(COMMAND szx_copy_runtime_dlls)
        szx_copy_runtime_dlls(${ARG_NAME})
    endif()
    target_link_libraries(${ARG_NAME} PRIVATE GTest::gtest GTest::gtest_main ${ARG_LIBS})
    if(ARG_INCLUDES)
        target_include_directories(${ARG_NAME} PRIVATE ${ARG_INCLUDES})
    endif()
    if(TARGET GTest::gmock)
        target_link_libraries(${ARG_NAME} PRIVATE GTest::gmock)
    endif()
    if(ARG_DEFINES)
        target_compile_definitions(${ARG_NAME} PRIVATE ${ARG_DEFINES})
    endif()
    if(COMMAND szx_apply_default_compile_policy)
        szx_apply_default_compile_policy(${ARG_NAME})
    endif()
    if(ARG_WORKING_DIRECTORY)
        set(_working_directory "${ARG_WORKING_DIRECTORY}")
    else()
        set(_working_directory "${CMAKE_CURRENT_BINARY_DIR}")
    endif()
    if(ARG_LABELS)
        set(_labels "${ARG_LABELS}")
    else()
        set(_labels unit)
    endif()
    set(_runtime_path "$<TARGET_FILE_DIR:${ARG_NAME}>")
    foreach(_runtime_target IN ITEMS szx_crypto szx_logger szx_camera szx_plc)
        if(TARGET "${_runtime_target}")
            string(APPEND _runtime_path ";$<TARGET_FILE_DIR:${_runtime_target}>")
        endif()
    endforeach()
    string(APPEND _runtime_path ";$ENV{PATH}")
    string(REPLACE ";" "\\;" _runtime_path_escaped "${_runtime_path}")
    if(ARG_NO_DISCOVER OR SZX_CTEST_REGISTRATION STREQUAL "binary")
        add_test(NAME ${ARG_NAME} COMMAND $<TARGET_FILE:${ARG_NAME}>)
        set_tests_properties(${ARG_NAME} PROPERTIES WORKING_DIRECTORY "${_working_directory}" LABELS "${_labels}" ENVIRONMENT "PATH=${_runtime_path_escaped}")
    else()
        include(GoogleTest)
        gtest_discover_tests(${ARG_NAME} DISCOVERY_MODE PRE_TEST WORKING_DIRECTORY "${_working_directory}"
            PROPERTIES LABELS "${_labels}" ENVIRONMENT "PATH=${_runtime_path_escaped}")
    endif()
endfunction()
